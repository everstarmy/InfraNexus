# Generate independent random values; do not commit .env.
DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# Local HTTP example; use production behind HTTPS.
APP_ENV=development
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For an HTTPS deployment, set true and use the HTTPS origin above.
SESSION_SECURE=false

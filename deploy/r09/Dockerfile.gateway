FROM node:24.11.1-alpine3.22 AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29.4-alpine3.23
COPY --from=frontend /src/dist /usr/share/nginx/html
COPY deploy/r09/nginx.conf /etc/nginx/nginx.conf
